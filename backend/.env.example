# Application Settings
ENVIRONMENT=production
PROJECT_NAME="Doctor Appointment Microservice"
VERSION=1.0.0
API_V1_STR=/api/v1

# PostgreSQL Microservice Configuration
POSTGRES_SERVER=postgres
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=crm_db
DATABASE_URL=postgresql+asyncpg://postgres:postgres@postgres:5432/crm_db

# CORS Allowed Origins (Comma separated or default)
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://127.0.0.1:3000","http://127.0.0.1:5173"]

